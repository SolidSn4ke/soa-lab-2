{
    "openapi": "3.0.3",
    "info": {
        "title": "SOA lab 1",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "https://localhost:42701/api",
            "description": "Helios"
        }
    ],
    "paths": {
        "/bars/discipline/{discipline-id}/labwork/{labwork-id}/remove": {
            "delete": {
                "summary": "Удалить лабораторную работу из программы дисциплины",
                "description": "Удалить лабораторную работу из программы дисциплины",
                "parameters": [
                    {
                        "name": "discipline-id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "minLength": 1
                        }
                    },
                    {
                        "name": "labwork-id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int32"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Успешное удаление лабораторной работы из программы дисциплины"
                    },
                    "400": {
                        "description": "Некорректный идентификатор",
                        "content": {
                            "application/xml": {
                                "schema": {
                                    "type": "object",
                                    "$ref": "#/components/schemas/ErrorMsg"
                                },
                                "example": {
                                    "msg": "Bad Request",
                                    "timestamp": "2026-09-12T12:32:49.032Z",
                                    "details": [
                                        "Can not apply parameter 'abc' to field 'id'. Expected: Integer, but got: String"
                                    ]
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Элемент с указанным ID не найден",
                        "content": {
                            "application/xml": {
                                "schema": {
                                    "type": "object",
                                    "$ref": "#/components/schemas/ErrorMsg"
                                },
                                "example": {
                                    "msg": "Not Found",
                                    "timestamp": "2026-09-12T12:32:49.032Z",
                                    "details": [
                                        "Element with labwork-id='1' not found"
                                    ]
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "content": {
                            "application/xml": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorMsg"
                                },
                                "example": {
                                    "msg": "Internal Error",
                                    "timestamp": "2026-09-12T12:32:49.032Z",
                                    "details": [
                                        "An internal server error occurred while processing the request"
                                    ]
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Сервис недоступен",
                        "content": {
                            "application/xml": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorMsg"
                                },
                                "example": {
                                    "msg": "Service Unavailable",
                                    "timestamp": "2026-09-12T12:32:49.032Z",
                                    "details": [
                                        "The service is temporarily unavailable"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/bars/discipline/{discipline-id}/make-hardcore": {
            "post": {
                "summary": "усложнить программу",
                "description": "добавить в программу указанной дисциплины 10 самых сложных лабораторных работ",
                "parameters": [
                    {
                        "name": "discipline-id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Успешный запрос",
                        "content": {
                            "application/xml": {
                                "schema": {
                                    "$ref": "#/components/schemas/Discipline"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Элемент с указанным ID не найден",
                        "content": {
                            "application/xml": {
                                "schema": {
                                    "type": "object",
                                    "$ref": "#/components/schemas/ErrorMsg"
                                },
                                "example": {
                                    "msg": "Not Found",
                                    "timestamp": "2026-09-12T12:32:49.032Z",
                                    "details": [
                                        "Element with discipline-id='abc' not found"
                                    ]
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "content": {
                            "application/xml": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorMsg"
                                },
                                "example": {
                                    "msg": "Internal Error",
                                    "timestamp": "2026-09-12T12:32:49.032Z",
                                    "details": [
                                        "An internal server error occurred while processing the request"
                                    ]
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Сервис недоступен",
                        "content": {
                            "application/xml": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorMsg"
                                },
                                "example": {
                                    "msg": "Service Unavailable",
                                    "timestamp": "2026-09-12T12:32:49.032Z",
                                    "details": [
                                        "The service is temporarily unavailable"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Discipline": {
                "type": "object",
                "required": [
                    "name",
                    "labsCount"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Поле не может быть null, Строка не может быть пустой",
                        "minLength": 1
                    },
                    "labsCount": {
                        "type": "integer",
                        "format": "int64"
                    }
                },
                "xml": {
                    "name": "Dicipline"
                }
            },
            "ErrorMsg": {
                "type": "object",
                "properties": {
                    "msg": {
                        "type": "string"
                    },
                    "timestamp": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "details": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "xml": {
                                "name": "detail"
                            }
                        },
                        "xml": {
                            "wrapped": true
                        }
                    }
                },
                "xml": {
                    "name": "ErrorMsg"
                }
            }
        }
    }
}